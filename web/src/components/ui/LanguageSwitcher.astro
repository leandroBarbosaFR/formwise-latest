---
import type { SiteContext } from '../../lib/data';
import { homePath } from '../../lib/links';
import { languageName } from '../../lib/languages';

interface Props {
	ctx: SiteContext;
	placement?: 'down' | 'up';
	// Icon only, as in the header design
	compact?: boolean;
	class?: string;
}
const { ctx, placement = 'down', compact = false, class: className } = Astro.props;
const label = ctx.layout.settings?.strings?.language ?? 'Language';
---

{
	ctx.languages.length > 1 && (
		<details data-dropdown class:list={['relative', className]}>
			<summary
				aria-label={label}
				class="glass flex cursor-pointer list-none items-center gap-2 rounded-full p-[11px] text-xs text-white uppercase [&::-webkit-details-marker]:hidden"
			>
				<img src="/figma/hero-globe.svg" alt="" width="18" height="18" class="size-[18px]" />
				{!compact && <span class="pr-1">{ctx.lang}</span>}
			</summary>
			<ul
				class:list={[
					'absolute right-0 z-30 grid max-h-80 w-56 grid-cols-1 overflow-y-auto rounded-xl bg-white p-2 text-sm text-ink shadow-xl ring-1 ring-black/5',
					placement === 'down' ? 'top-full mt-2' : 'bottom-full mb-2',
				]}
			>
				{ctx.languages.map((lang) => (
					<li>
						<a
							href={ctx.alternates[lang] ?? homePath(lang)}
							hreflang={lang}
							lang={lang}
							aria-current={lang === ctx.lang ? 'true' : undefined}
							class:list={[
								'flex items-center justify-between rounded-lg px-3 py-2 transition hover:bg-brand-soft',
								lang === ctx.lang && 'bg-brand-soft text-brand',
							]}
						>
							{languageName(lang)}
							<span class="type-small text-slate uppercase">{lang}</span>
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}
