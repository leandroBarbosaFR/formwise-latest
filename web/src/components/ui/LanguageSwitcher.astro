---
import type { SiteContext } from '../../lib/data';
import { homePath } from '../../lib/links';
import { languageName } from '../../lib/languages';

interface Props {
	ctx: SiteContext;
	placement?: 'down' | 'up';
	// Icon only, as in the header design
	compact?: boolean;
	class?: string;
}
const { ctx, placement = 'down', compact = false, class: className } = Astro.props;
const label = ctx.layout.settings?.strings?.language ?? 'Language';
---

{
	ctx.languages.length > 1 && (
		<details data-dropdown class:list={['relative', className]}>
			<summary
				aria-label={label}
				class="glass flex cursor-pointer list-none items-center gap-2 rounded-full p-[11px] text-xs text-white uppercase [&::-webkit-details-marker]:hidden"
			>
				<img src="/figma/hero-globe.svg" alt="" width="18" height="18" class="size-[18px]" />
				{!compact && <span class="pr-1">{ctx.lang}</span>}
			</summary>
			<ul
				class:list={[
					// Same blue glass card as the menu
					'language-list absolute right-0 z-30 grid max-h-80 w-56 grid-cols-1 overflow-y-auto rounded-2xl bg-brand/75 p-2 text-sm text-white shadow-xl ring-1 ring-white/10 backdrop-blur-2xl',
					placement === 'down' ? 'top-full mt-2' : 'bottom-full mb-2',
				]}
			>
				{ctx.languages.map((lang) => (
					<li>
						<a
							href={ctx.alternates[lang] ?? homePath(lang)}
							hreflang={lang}
							lang={lang}
							aria-current={lang === ctx.lang ? 'true' : undefined}
							class:list={[
								'flex items-center justify-between rounded-lg px-3 py-2 transition',
								lang === ctx.lang ? 'bg-white/15 text-white' : 'text-white/75 hover:bg-white/10 hover:text-white',
							]}
						>
							{languageName(lang)}
							<span class="text-xs tracking-[0.08em] text-white uppercase">{lang}</span>
						</a>
					</li>
				))}
			</ul>
		</details>
	)
}

<style>
	/* Discreet scrollbar on the blue card */
	.language-list {
		scrollbar-width: thin;
		scrollbar-color: rgb(255 255 255 / 0.3) transparent;
	}
</style>
