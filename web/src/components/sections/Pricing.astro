---
import type { SiteContext } from '../../lib/data';
import type { Button, Section } from '../../lib/types';
import ButtonLink from '../ui/ButtonLink.astro';
import Divider from './Divider.astro';

interface Props {
	section: Section;
	ctx: SiteContext;
}
const { section, ctx } = Astro.props;

interface Plan {
	_id: string;
	name: string;
	price: string;
	priceDetails?: string[];
	description?: string;
	features?: string[];
	featured?: boolean;
	badge?: string;
	cta?: Button;
}
const plans: Plan[] = (section.plans ?? []).filter(Boolean);
---

<section
	id={section.anchorId ?? 'pricing'}
	class="mx-auto flex max-w-[1440px] flex-col items-center gap-8 px-6 py-20 lg:py-[120px]"
>
	{section.heading && <h2 class="type-h2 max-w-[561px] text-center">{section.heading}</h2>}
	{section.text && <p class="type-body max-w-[395px] text-center">{section.text}</p>}

	<div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
		{
			plans.map((plan) => (
				<article
					class:list={[
						'relative flex flex-col items-center gap-6 overflow-clip rounded-xl py-6',
						plan.featured ? 'bg-brand text-white' : 'border border-black/10 bg-white text-black',
					]}
				>
					{plan.featured && (
						<div class="absolute top-[-16px] left-[-22px] h-[578px] w-[378px]" aria-hidden="true">
							<img src="/figma/hero-bg-1.png" alt="" class="absolute inset-0 size-full max-w-none" />
							<div class="absolute inset-0 overflow-hidden">
								<img
									src="/figma/hero-bg-2.png"
									alt=""
									class="absolute top-[-0.06%] left-[-236.64%] h-[294.23%] w-[573.02%] max-w-none"
								/>
							</div>
						</div>
					)}

					<div class="relative flex w-full items-start gap-6 px-6">
						<div class="flex min-w-0 flex-1 flex-col gap-1">
							<h3 class="text-base leading-[1.2] font-medium">{plan.name}</h3>
							<p class="text-[32px] leading-[1.2] font-medium">{plan.price}</p>
							{plan.priceDetails?.map((line) => (
								<p class="text-xs leading-[1.4] font-light whitespace-nowrap">{line}</p>
							))}
						</div>
						{plan.featured && plan.badge && (
							<span class="shrink-0 rounded bg-brand-soft px-2 py-1 text-xs leading-[1.3] font-demi text-brand">
								{plan.badge}
							</span>
						)}
					</div>

					<Divider src="/figma/pricing-line.svg" class="relative" />

					<div class="relative flex w-full flex-1 flex-col gap-3 px-6">
						{plan.description && <p class="max-w-[215px] text-sm leading-[1.2] font-medium">{plan.description}</p>}
						<ul class="flex flex-col gap-3">
							{plan.features?.map((feature) => (
								<li class="flex items-center gap-2">
									<span class="relative size-5 shrink-0 overflow-clip rounded-[3.2px]">
										<span class="absolute inset-[8.32%_8.33%_8.35%_8.34%]">
											<img
												src={plan.featured ? '/figma/check-white.svg' : '/figma/check.svg'}
												alt=""
												class="absolute inset-0 block size-full max-w-none"
											/>
										</span>
									</span>
									<span class="flex-1 text-sm leading-normal">{feature}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="relative w-full px-6">
						<ButtonLink
							button={plan.cta}
							ctx={ctx}
							class:list={[
								'flex h-10 w-full items-center justify-center rounded-full px-[18px] py-2 text-sm leading-normal transition',
								plan.featured
									? 'bg-white text-brand hover:bg-brand-soft'
									: 'border border-black bg-white text-black hover:bg-black hover:text-white',
							]}
						/>
					</div>
				</article>
			))
		}
	</div>
</section>
