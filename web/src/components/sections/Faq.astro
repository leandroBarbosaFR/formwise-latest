---
import type { SiteContext } from '../../lib/data';
import type { RichText as RichTextValue, Section } from '../../lib/types';
import RichText from '../rich-text/RichText.astro';
import Divider from './Divider.astro';

interface Props {
	section: Section;
	ctx: SiteContext;
}
const { section, ctx } = Astro.props;
const faqs: { _id: string; question: string; answer?: RichTextValue }[] = (section.faqs ?? []).filter(Boolean);
---

<section id={section.anchorId ?? 'faq'} class="bg-brand text-white">
	<div class="mx-auto flex max-w-[676px] flex-col items-center px-6 py-20 lg:box-content lg:py-[120px]">
		{section.heading && <h2 class="type-h1 max-w-[561px] text-center">{section.heading}</h2>}

		<div class="mt-[58px] flex w-full flex-col gap-8">
			{
				// Figma puts a rule above every question and none after the last one
				faqs.map((faq, i) => (
					<>
						<Divider src="/figma/faq-line.svg" />
						<details class="group" name={`faq-${section._key}`} open={i === 0}>
							<summary class="flex cursor-pointer list-none items-center gap-8 [&::-webkit-details-marker]:hidden">
								<span class="flex-1 text-xl leading-[1.1] sm:text-2xl">{faq.question}</span>
								<img src="/figma/faq-plus.svg" alt="" width="40" height="40" class="size-10 shrink-0 group-open:hidden" />
								<img src="/figma/faq-minus.svg" alt="" width="40" height="40" class="hidden size-10 shrink-0 group-open:block" />
							</summary>
							<RichText
								value={faq.answer}
								ctx={ctx}
								class="prose-invert mt-4 max-w-[604px] text-base leading-[1.3] font-extralight"
							/>
						</details>
					</>
				))
			}
		</div>
	</div>
</section>
