---
import type { Section } from '../../lib/types';
import Divider from './Divider.astro';

interface Props {
	section: Section;
}
const { section } = Astro.props;
const testimonials: { _id: string; quote: string; name: string; role?: string; rating?: number }[] = (
	section.testimonials ?? []
).filter(Boolean);
---

<section id={section.anchorId} class="mx-auto flex max-w-[1440px] flex-col items-center gap-8 px-6 py-20 lg:py-[120px]">
	{section.heading && <h2 class="type-h2 max-w-[561px] text-center">{section.heading}</h2>}
	{section.text && <p class="type-body max-w-[510px] text-center">{section.text}</p>}
	<div class="grid w-full grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
		{
			testimonials.map((t) => (
				<figure class="flex flex-col gap-5 overflow-clip rounded-2xl border border-black/10 px-6 py-8">
					<div class="flex flex-col gap-2">
						{t.rating && (
							<div class="flex gap-1" role="img" aria-label={`${t.rating}/5`}>
								{Array.from({ length: t.rating }, () => (
									<img src="/figma/star.svg" alt="" width="16" height="16" class="size-4" />
								))}
							</div>
						)}
						<blockquote class="type-body max-w-[395px]">“{t.quote}”</blockquote>
					</div>
					<Divider src="/figma/testimonial-line-1.svg" />
					<figcaption class="flex flex-col gap-1">
						<p class="text-lg leading-[1.2] tracking-[-0.02em]">{t.name}</p>
						{t.role && <p class="type-small text-slate">{t.role}</p>}
					</figcaption>
				</figure>
			))
		}
	</div>
</section>
