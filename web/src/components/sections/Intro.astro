---
// Splash played over the home hero on the first visit of a session (Figma "Intro Prototype"):
// the camera pulls out of the logo's arch, a white sheet slides up over the logo,
// then the hero card fades in while the giant wordmark rises. Delays and spring match the prototype.
import logoSvg from '../../../public/figma/intro-logo.svg?raw';

// The logo's shapes, drawn inline so the zoom can move the "camera" (the viewBox) over them:
// the browser only ever draws one screen of pixels, sharp at any zoom level
const logoShapes = logoSvg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<script is:inline>
	// Runs before the first paint so the hero never flashes before the splash.
	// Without JS, with reduced motion, or after the first visit, nothing happens.
	try {
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('formwise-intro')) {
			document.documentElement.dataset.intro = '';
			// If the animation script never runs, don't leave the page covered
			window.__introFailsafe = setTimeout(() => delete document.documentElement.dataset.intro, 15000);
		}
	} catch {}
</script>

<div data-intro-overlay aria-hidden="true" class="fixed inset-0 z-50 hidden overflow-clip bg-[#0349aa]">
	<!-- Hidden until the script frames it: its default viewBox would stretch the whole logo across the
	     screen. Frame 1 is solid blue anyway (the camera starts inside the arch). -->
	<svg data-intro-logo viewBox="0 0 264.025 39.6986" preserveAspectRatio="none" fill="none" class="invisible absolute inset-0 size-full">
		<Fragment set:html={logoShapes} />
	</svg>
	<div data-intro-sheet class="absolute inset-0 translate-y-[calc(100%+20px)] bg-white"></div>
</div>

<style is:global>
	html[data-intro] {
		overflow: hidden;
	}
	html[data-intro] [data-intro-overlay] {
		display: block;
	}
	/* The page is white under the sheet (Figma frame 3): the hero card waits to fade in */
	html[data-intro] [data-hero] {
		opacity: 0;
	}
</style>

<script>
	import { lerp, springAnimate, springAt, wait } from '../../lib/motion';

	const root = document.documentElement;
	const overlay = document.querySelector<HTMLElement>('[data-intro-overlay]');

	// Figma "Intro Prototype": every step is Smart animate, after a delay, with the same spring
	const DELAY = { zoom: 800, sheet: 2000, hero: 1 };
	const SPRING = { mass: 1, stiffness: 20, damping: 10 };

	// Logo geometry in the 1440×900 frames: frame 1 zooms into the arch, frame 2 centres the logo
	const ARTBOARD = { width: 1440, height: 900 };
	const LOGO = { width: 264.025, height: 39.6986 };
	const ZOOMED = { left: -1285, top: -2106, width: 26523.168 };
	// The hero wordmark sits 136 design pixels lower in frame 3 and rises in frame 4
	const WORDMARK_RISE = 136;

	const SPRING_CURVE = springAt(SPRING);
	const springStep = (el: Element, frame: (p: number) => Keyframe) => springAnimate(el, SPRING, frame);
	const mix = (from: number[], to: number[], p: number) => `rgb(${from.map((c, i) => Math.round(lerp(c, to[i], p))).join(' ')})`;

	async function play(overlay: HTMLElement) {
		clearTimeout((window as any).__introFailsafe);
		try {
			sessionStorage.setItem('formwise-intro', '1');
		} catch {}
		window.scrollTo(0, 0);

		const logo = overlay.querySelector<HTMLElement>('[data-intro-logo]')!;
		const sheet = overlay.querySelector<HTMLElement>('[data-intro-sheet]')!;
		const hero = document.querySelector<HTMLElement>('[data-hero]');

		// Frame 1 → 2: pull out of the arch to the centred logo, blue #0349aa → #023d9d.
		// The zoom moves the SVG viewBox (a camera over the logo), so each frame only draws one screen
		// of pixels. Frame 1 is scaled up on screens larger than the artboard so the arch still fills them.
		const W = innerWidth;
		const H = innerHeight;
		const k = Math.max(1, W / ARTBOARD.width, H / ARTBOARD.height);
		// Pixels per logo unit at the start (frame 1) and at the end (frame 2, actual size)
		const startScale = (ZOOMED.width * k) / LOGO.width;
		// The logo point at the centre of the screen in frame 1 (inside the arch), in logo units
		const anchor = {
			x: (W / 2 - (W / 2 + (ZOOMED.left - ARTBOARD.width / 2) * k)) / startScale,
			y: (H / 2 - (H / 2 + (ZOOMED.top - ARTBOARD.height / 2) * k)) / startScale,
		};
		// Where that point sits on screen once the logo is centred
		const anchorEnd = { x: (W - LOGO.width) / 2 + anchor.x, y: (H - LOGO.height) / 2 + anchor.y };
		const showZoom = (p: number) => {
			// Zoom on a log scale so it reads as an even pull-out with an invisible tail;
			// the anchor glides from the screen centre to its place in the centred logo
			const scale = startScale ** (1 - p);
			const ax = lerp(W / 2, anchorEnd.x, p);
			const ay = lerp(H / 2, anchorEnd.y, p);
			logo.setAttribute('viewBox', `${anchor.x - ax / scale} ${anchor.y - ay / scale} ${W / scale} ${H / scale}`);
			overlay.style.backgroundColor = mix([3, 73, 170], [2, 61, 157], p);
		};
		showZoom(0);
		logo.classList.remove('invisible');
		await wait(DELAY.zoom);
		await new Promise<void>((resolve) => {
			const t0 = performance.now();
			const frame = (now: number) => {
				const t = now - t0;
				showZoom(SPRING_CURVE.at(t));
				if (t < SPRING_CURVE.duration) requestAnimationFrame(frame);
				else resolve();
			};
			requestAnimationFrame(frame);
		});
		if (!hero) return;

		// Frame 2 → 3: the white page slides up over the logo
		await wait(DELAY.sheet);
		// Animates `translate`, the same property the class uses to park it below the screen
		await springStep(sheet, (p) => ({ translate: `0 calc(${1 - p} * (100% + 20px))` }));

		// The page underneath is white with the hero hidden, so the overlay can go without a seam
		overlay.remove();

		// Frame 3 → 4: the hero card fades in while the wordmark rises into place
		await wait(DELAY.hero);
		const wordmark = hero.querySelector<HTMLElement>('[data-hero-layer="wordmark"]');
		const rise = WORDMARK_RISE * (hero.offsetWidth / 1392);
		await Promise.all([
			springStep(hero, (p) => ({ opacity: p })),
			wordmark && springStep(wordmark, (p) => ({ transform: `translateY(${(1 - p) * rise}px)` })),
		]);

		delete root.dataset.intro;
		[hero, wordmark].forEach((el) => el?.getAnimations().forEach((animation) => animation.cancel()));
	}

	if (overlay && 'intro' in root.dataset) {
		play(overlay)
			.catch(() => {})
			.finally(() => {
				overlay.remove();
				delete root.dataset.intro;
			});
	} else {
		overlay?.remove();
	}
</script>
