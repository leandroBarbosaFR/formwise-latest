---
import type { Section } from '../../lib/types';

interface Props {
	section: Section;
}
const { section } = Astro.props;
const words: string[] = section.words ?? [];

// One scroll step per Figma frame: lift the eyebrow, bring in each word (the footnote rides up with
// the last one), then settle the footnote. Steps for a missing eyebrow or footnote are skipped.
// Plus one step of rest at the end, so the finished list stays before the page glides on.
const STEP_SVH = 40;
const steps = (section.eyebrow ? 1 : 0) + words.length + (section.footnote ? 1 : 0);
const trackHeight = `calc(100svh + ${(steps + 1) * STEP_SVH}svh)`;
---

<!--
	Without JS (or with reduced motion) this renders the finished list.
	An inline script adds `data-scrolly` before the first paint (so the page height, and scroll
	restoration on reload, are right from the start): the section becomes a tall scroll track with a pinned panel.
	Scrolling steps through the Figma "Scroll Prototype" frames: each step springs the next word up
	from below the fold, and once all the text is in, the page glides on to the next section.
-->
<section id={section.anchorId} class="group bg-brand" data-word-wheel data-step-svh={STEP_SVH}>
	<div data-track style={`--track-height: ${trackHeight}`} class="group-data-scrolly:h-(--track-height)">
		<div
			class="mx-auto flex min-h-[900px] max-w-[561px] flex-col items-center justify-center gap-16 px-6 py-24 text-center group-data-scrolly:sticky group-data-scrolly:top-0 group-data-scrolly:h-svh group-data-scrolly:min-h-0 group-data-scrolly:overflow-clip group-data-scrolly:py-0"
		>
			{section.eyebrow && <p data-eyebrow class="type-body font-normal text-mist">{section.eyebrow}</p>}
			<ul class="flex flex-col gap-14 text-[36px] leading-[1.2] tracking-[-0.02em] text-white sm:text-[48px]">
				{words.map((word) => <li data-item class="will-change-transform">{word}</li>)}
			</ul>
			{section.footnote && <p data-footnote class="type-body font-normal text-mist">{section.footnote}</p>}
		</div>
	</div>
</section>
<script is:inline>
	(function (section) {
		if (section.querySelector('[data-item]') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
			section.dataset.scrolly = '';
		}
	})(document.currentScript.previousElementSibling);
</script>

<script>
	import { easeInOut, springAnimate } from '../../lib/motion';

	// Figma "Scroll Prototype": each step is Smart animate with this spring; once all the text is in,
	// the page moves on to the next section with Ease in and out over 1600ms
	const SPRING = { mass: 1, stiffness: 180, damping: 30 };
	const EXIT_MS = 1600;
	// Design pixels on the 900px-tall frame
	const ARTBOARD_HEIGHT = 900;
	const EYEBROW_LIFT = 48; // "Control" starts at 159 and settles at 111
	const BELOW_FOLD = 45; // waiting words sit just under the fold (945 on a 900 frame)
	const FOOTNOTE_OVERSHOOT = 56; // the footnote lands 56 low with the last word, then settles
	const EXIT_DISTANCE = 1350; // frame 9: the section has moved 1350 up, showing half of the next one

	const SCROLL_KEYS = new Set(['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' ']);

	function setup(section: HTMLElement) {
		const track = section.querySelector<HTMLElement>('[data-track]')!;
		const panel = track.firstElementChild as HTMLElement;
		const eyebrow = section.querySelector<HTMLElement>('[data-eyebrow]');
		const footnote = section.querySelector<HTMLElement>('[data-footnote]');
		const items = [...section.querySelectorAll<HTMLElement>('[data-item]')];
		const count = items.length;
		// Scroll distance that advances one step, in viewport heights (the track height is set in the markup)
		const stepSvh = Number(section.dataset.stepSvh);

		// Steps as in the markup: eyebrow, each word (footnote rides with the last), footnote settles
		const firstWord = eyebrow ? 2 : 1;
		const lastWord = firstWord + count - 1;
		const steps = lastWord + (footnote ? 1 : 0);

		// Sizes come from the pinned panel (100svh), which doesn't change when mobile browser bars
		// show or hide, unlike the window height
		let height = 0;
		let rise = 0;
		const measure = () => {
			height = panel.offsetHeight;
			// Words wait just under the fold. offsetTop is relative to the sticky panel and ignores transforms.
			rise = height + BELOW_FOLD - items[0].offsetTop;
		};

		// Where each element sits at a given step
		const targets = (step: number): [HTMLElement | null, number][] => [
			[eyebrow, step >= 1 ? 0 : EYEBROW_LIFT],
			...items.map((item, i): [HTMLElement, number] => [item, step >= firstWord + i ? 0 : rise]),
			[footnote, step >= lastWord + 1 ? 0 : step >= lastWord ? FOOTNOTE_OVERSHOOT : rise],
		];
		const currentY = (el: HTMLElement) => new DOMMatrix(getComputedStyle(el).transform).m42;
		const place = (step: number) =>
			targets(step).forEach(([el, y]) => {
				if (!el) return;
				el.getAnimations().forEach((animation) => animation.cancel());
				el.style.transform = `translate3d(0, ${y}px, 0)`;
			});
		// Springs every element that changed from wherever it is now, so fast scrolling or
		// reversing mid-way stays smooth
		const animateTo = (step: number) =>
			targets(step).forEach(([el, y]) => {
				if (!el) return;
				const from = currentY(el);
				if (Math.abs(from - y) < 0.5) return;
				el.getAnimations().forEach((animation) => animation.cancel());
				el.style.transform = `translate3d(0, ${y}px, 0)`;
				springAnimate(el, SPRING, (p) => ({ transform: `translate3d(0, ${from + (y - from) * p}px, 0)` }))
					// Cancelled by a newer step
					.catch(() => {});
			});

		// How far the page has scrolled into the track, and where the panel unpins
		const scrolled = () => -track.getBoundingClientRect().top;
		const unpinAt = () => track.offsetHeight - height;
		// A pixel of tolerance: scroll positions can be fractional (e.g. 0.3px into the track at the start)
		const stepAt = () => Math.min(Math.max(Math.ceil((scrolled() - 1) / ((stepSvh / 100) * height)), 0), steps);

		// Once all the text is in, scrolling past the end of the track glides to the next section.
		// Input is held while it glides so the wheel or a swipe doesn't fight it.
		let gliding = false;
		const hold = (event: Event) => {
			if (gliding) event.preventDefault();
		};
		window.addEventListener('wheel', hold, { passive: false });
		window.addEventListener('touchmove', hold, { passive: false });
		window.addEventListener('keydown', (event) => {
			if (gliding && SCROLL_KEYS.has(event.key)) event.preventDefault();
		});

		function glide() {
			const start = window.scrollY;
			// Frame 9: the section has moved EXIT_DISTANCE up from where the panel unpins
			const end = window.scrollY - scrolled() + unpinAt() + (EXIT_DISTANCE / ARTBOARD_HEIGHT) * height;
			// Momentum already carried the page past it: nothing to do
			if (end <= start) return;
			gliding = true;
			document.documentElement.style.overflow = 'hidden';
			const t0 = performance.now();
			const frame = (now: number) => {
				const t = Math.min((now - t0) / EXIT_MS, 1);
				window.scrollTo(0, start + (end - start) * easeInOut(t));
				if (t < 1) return void requestAnimationFrame(frame);
				gliding = false;
				document.documentElement.style.overflow = '';
			};
			requestAnimationFrame(frame);
		}

		let step = -1;
		let lastY = window.scrollY;
		let armed = true;
		const update = () => {
			const complete = step === steps;
			const next = stepAt();
			if (next !== step) {
				// First run (page load, or a reload halfway down) jumps straight to the right state
				if (step === -1) place(next);
				else animateTo(next);
				step = next;
			}
			const down = window.scrollY > lastY;
			lastY = window.scrollY;
			const pastEnd = scrolled() >= unpinAt() - 1;
			// Re-arm once the visitor is back inside the track
			if (!pastEnd) armed = true;
			// Only when all the text was already in, not when one fast scroll jumped through the steps
			if (armed && pastEnd && down && complete && !gliding) {
				armed = false;
				glide();
			}
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};

		measure();
		update();
		window.addEventListener('scroll', schedule, { passive: true });
		// The panel only changes size when the layout really changes (width, rotation, fonts)
		new ResizeObserver(() => {
			const before = height;
			measure();
			if (height !== before) place(step);
		}).observe(panel);
		// Word positions change once the brand font swaps in
		document.fonts.ready.then(() => {
			measure();
			place(step);
		});
	}

	// The inline script only turns on the scroll track when there are words and motion is allowed
	document.querySelectorAll<HTMLElement>('[data-word-wheel][data-scrolly]').forEach(setup);
</script>
