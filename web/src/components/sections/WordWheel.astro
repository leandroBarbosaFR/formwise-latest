---
import type { Section } from '../../lib/types';

interface Props {
	section: Section;
}
const { section } = Astro.props;
const words: string[] = section.words ?? [];
---

<!--
	Without JS (or with reduced motion) this renders the finished list.
	The script adds `data-scrolly`: the section becomes a tall scroll track with a
	pinned panel, and the words rise from below the fold one by one, stacking into the list.
-->
<section id={section.anchorId} class="group bg-brand" data-word-wheel>
	<div data-track>
		<div
			class="mx-auto flex min-h-[900px] max-w-[561px] flex-col items-center justify-center gap-16 px-6 py-24 text-center group-data-scrolly:sticky group-data-scrolly:top-0 group-data-scrolly:h-svh group-data-scrolly:min-h-0 group-data-scrolly:overflow-clip group-data-scrolly:py-0"
		>
			{section.eyebrow && <p data-eyebrow class="type-body font-normal text-mist">{section.eyebrow}</p>}
			<ul class="flex flex-col gap-14 text-[36px] leading-[1.2] tracking-[-0.02em] text-white sm:text-[48px]">
				{words.map((word) => <li data-item class="will-change-transform">{word}</li>)}
			</ul>
			{section.footnote && <p data-footnote class="type-body font-normal text-mist">{section.footnote}</p>}
		</div>
	</div>
</section>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Scroll distance spent on each step, in viewport heights
	const STEP_SVH = 40;
	// The eyebrow starts 48 design pixels lower and lifts as the section pins
	const EYEBROW_LIFT = 48;
	// The footnote lands 56 design pixels low with the last word, then settles
	const FOOTNOTE_OVERSHOOT = 56;
	// Words land at the top of the fold plus this, as in the design (945px on a 900px frame)
	const BELOW_FOLD = 45;
	// Steps of stillness at the end, so the finished list stays a moment before scrolling away
	const HOLD = 0.75;

	// Smoothstep: each word settles before the next one moves in
	const ease = (t: number) => t * t * (3 - 2 * t);
	const clamp = (t: number) => Math.min(Math.max(t, 0), 1);

	function setup(section: HTMLElement) {
		const track = section.querySelector<HTMLElement>('[data-track]')!;
		const eyebrow = section.querySelector<HTMLElement>('[data-eyebrow]');
		const footnote = section.querySelector<HTMLElement>('[data-footnote]');
		const items = [...section.querySelectorAll<HTMLElement>('[data-item]')];
		const count = items.length;
		if (count === 0) return;

		// Step 0 lifts the eyebrow, steps 1…count bring in the words, the last one settles the footnote
		const steps = count + 2;
		section.dataset.scrolly = '';
		track.style.height = `calc(100svh + ${(steps + HOLD) * STEP_SVH}svh)`;

		// How far the words travel: from just below the fold to their place in the list
		let rise = 0;
		const measure = () => {
			// offsetTop is relative to the sticky panel and ignores transforms
			rise = window.innerHeight + BELOW_FOLD - items[0].offsetTop;
		};

		const update = () => {
			const scrollable = track.offsetHeight - window.innerHeight;
			const position = clamp(-track.getBoundingClientRect().top / scrollable) * (steps + HOLD);
			const stepProgress = (step: number) => ease(clamp(position - step));

			if (eyebrow) eyebrow.style.transform = `translate3d(0, ${(1 - stepProgress(0)) * EYEBROW_LIFT}px, 0)`;
			items.forEach((item, i) => {
				item.style.transform = `translate3d(0, ${(1 - stepProgress(i + 1)) * rise}px, 0)`;
			});
			if (footnote) {
				// Rides up with the last word, then settles into place
				const arrive = stepProgress(count);
				const settle = stepProgress(count + 1);
				const offset = (1 - arrive) * rise + arrive * (1 - settle) * FOOTNOTE_OVERSHOOT;
				footnote.style.transform = `translate3d(0, ${offset}px, 0)`;
			}
		};

		let frame = 0;
		const schedule = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		};

		measure();
		update();
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', () => {
			measure();
			schedule();
		});
		// Word heights change once the brand font swaps in
		document.fonts.ready.then(() => {
			measure();
			update();
		});
	}

	if (!reduceMotion) document.querySelectorAll<HTMLElement>('[data-word-wheel]').forEach(setup);
</script>
