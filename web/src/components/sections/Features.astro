---
import type { Section } from '../../lib/types';
import Avatar from './Avatar.astro';

interface Props {
	section: Section;
}
const { section } = Astro.props;

const img = (name: string) => `/figma/${name}`;

const members = [
	{
		name: 'Julien Amare',
		under: { src: img('avatar-117.webp'), w: 66, h: 99, dx: 1, dy: 16.5 },
		over: { src: img('avatar-121.webp'), w: 40, h: 40 },
	},
	{
		name: 'Claire Bernard',
		under: { src: img('avatar-115.webp'), w: 96, h: 96, dy: 16 },
		over: { src: img('avatar-122.webp'), w: 40, h: 40 },
	},
	{
		name: 'Marie Dupont',
		under: { src: img('avatar-116.webp'), w: 84, h: 137, dy: 26.5 },
		over: { src: img('avatar-123.webp'), w: 40, h: 40 },
	},
	{
		name: 'Jean Dupuis',
		bg: '#227aca',
		under: { src: img('avatar-118.webp'), w: 56, h: 56, dx: -8, dy: 8 },
		over: { src: img('avatar-124.webp'), w: 40, h: 40 },
	},
];

// Avatars floating around the payment chip, positioned within the 332×352 card.
// `z: -1` tucks one behind the chip (the panel is its own stacking context, so it stays above the white).
const payers = [
	{
		left: 40, top: 201, size: 40, z: -1,
		under: { src: img('avatar-119.webp'), w: 126, h: 101, dx: -2, dy: 15.5 },
		over: { src: img('avatar-123.webp'), w: 40, h: 40 },
	},
	{
		left: 83, top: 101, size: 23.061,
		under: { src: img('avatar-117.webp'), w: 38.05, h: 57.075, dx: 0.58, dy: 9.51 },
		over: { src: img('avatar-121.webp'), w: 23, h: 23, dx: -0.03, dy: -0.03 },
	},
	{
		left: 217, top: 93, size: 40,
		under: { src: img('avatar-115.webp'), w: 96, h: 96, dy: 16 },
		over: { src: img('avatar-122.webp'), w: 40, h: 40 },
	},
	{
		left: 240, top: 175, size: 52.332,
		under: { src: img('avatar-116.webp'), w: 110.099, h: 178.91, dx: 0.1, dy: 34.51 },
		over: { src: img('avatar-124.webp'), w: 52, h: 52, dx: -0.17, dy: -0.17 },
	},
	{
		left: 131, top: 241, size: 70, bg: '#227aca',
		under: { src: img('avatar-118.webp'), w: 98, h: 98, dx: -14, dy: 14 },
		over: { src: img('avatar-125.webp'), w: 70, h: 70 },
	},
];

// Illustrations are part of the design; their texts and the captions come from Sanity.
// Each card shares the same base photo, then a heavily blurred photo stack
// offset differently so every card picks up a different part of the colour field.
const backgrounds = [
	{ blurLeft: -375, blurTop: -131, blurLayers: ['feat-blur-1.webp'] },
	{ blurLeft: -1399.67, blurTop: -305, blurLayers: ['feat-blur-1.webp', 'feat-blur-2.webp'] },
	{ blurLeft: -1045.33, blurTop: -163, blurLayers: ['feat-blur-1.webp', 'feat-blur-2.webp', 'feat-blur-3.webp'] },
];


interface Card {
	_key: string;
	illustration: string;
	title: string;
	text?: string;
	panelTitle?: string;
	panelLabel?: string;
	panelAmount?: string;
	panelDetail?: string;
	panelReply?: string;
}
const cards: Card[] = section.cards ?? [];

// Greetings floating around the globe, positioned within the 332×352 card. Not translated on purpose.
const greetings = [
	{ text: 'Bonjour', left: 28, top: 84 },
	{ text: 'Hello', left: 226, top: 72 },
	{ text: 'Hola', left: 12, top: 168 },
	{ text: 'Hallo', left: 244, top: 156 },
	{ text: 'Ciao', left: 30, top: 244 },
	{ text: 'Olá', left: 248, top: 238 },
];

// Lines of the AI draft, as a share of the panel width
const draftLines = ['100%', '92%', '96%', '64%'];

const panel = 'absolute top-1/2 left-1/2 h-[352px] w-[332px] -translate-1/2 overflow-clip rounded-xl bg-white';
---

<section id={section.anchorId} class="mx-auto flex max-w-[1440px] flex-col items-center px-6 py-20 lg:py-[120px]">
	{section.heading && <h2 class="type-h2 max-w-[561px] text-center">{section.heading}</h2>}
	{section.text && <p class="type-body mt-6 max-w-[395px] text-center">{section.text}</p>}

	<div class="mt-10 grid w-full grid-cols-1 gap-5 lg:grid-cols-3">
		{
			cards.map((card, i) => {
				const background = backgrounds[i % backgrounds.length];
				return (
				<div class="flex flex-col gap-5">
					<div class="relative h-[504px] overflow-clip rounded-2xl bg-brand" aria-hidden="true" data-feature-card>
						<img
							src={img('dash-bg.webp')}
							alt=""
							class="absolute top-[-94px] left-[-710px] h-[1023px] w-[1534px] max-w-none object-cover"
						/>
						<div
							class="absolute h-[1358px] w-[2037px] blur-[102px]"
							style={`left:${background.blurLeft}px;top:${background.blurTop}px`}
						>
							{background.blurLayers.map((layer) => (
								<img src={img(layer)} alt="" class="absolute inset-0 size-full max-w-none object-cover" />
							))}
						</div>

						{card.illustration === 'support' && (
							<div class:list={[panel, 'flex flex-col gap-5 p-6']}>
								<div class="flex items-center justify-between gap-3">
									<p class="type-h4">{card.panelTitle ?? 'Formwise support'}</p>
									<span class="flex shrink-0 items-center gap-1.5 rounded bg-[#def5dc] px-2 py-1 text-xs leading-[1.3] font-demi text-[#0a8502]">
										<span class="size-1.5 rounded-full bg-[#0a8502]" />
										{card.panelLabel ?? 'Online'}
									</span>
								</div>
								<div class="flex flex-1 flex-col justify-center gap-4">
									<div class="fx-up flex items-end gap-2" style="--i:0">
										<Avatar size={40} bg={members[3].bg} under={members[3].under} over={members[3].over} />
										<p class="max-w-[220px] rounded-2xl rounded-bl-sm bg-[#f1f3f6] px-4 py-3 text-sm leading-[1.3]">
											{card.panelDetail ?? 'How do I import my member list?'}
										</p>
									</div>
									<div class="fx-up flex items-end justify-end gap-2" style="--i:1">
										<p class="max-w-[220px] rounded-2xl rounded-br-sm bg-brand px-4 py-3 text-sm leading-[1.3] text-white">
											{card.panelReply ?? 'Hi! Send us your file, we’ll set it up with you today.'}
										</p>
										<Avatar size={40} under={members[1].under} over={members[1].over} />
									</div>
									<div class="fx-up flex items-end gap-2" style="--i:2">
										<Avatar size={40} bg={members[3].bg} under={members[3].under} over={members[3].over} />
										<p class="flex gap-1 rounded-2xl rounded-bl-sm bg-[#f1f3f6] px-4 py-4">
											{[0, 1, 2].map((dot) => (
												<span class="fx-typing size-1.5 rounded-full bg-slate" style={`--i:${dot}`} />
											))}
										</p>
									</div>
								</div>
							</div>
						)}

						{card.illustration === 'assistant' && (
							<div class:list={[panel, 'flex flex-col gap-4 p-6']}>
								<p class="type-h4">{card.panelTitle ?? 'AI assistant'}</p>
								<div class="flex flex-1 flex-col justify-center gap-4">
								<div class="flex items-start gap-2 rounded-xl border border-black/10 p-3">
									<svg viewBox="0 0 24 24" class="mt-px size-4 shrink-0 text-brand" fill="currentColor" aria-hidden="true">
										<path d="M12 2l1.9 6.1L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.9L12 2zm7 12l.9 2.6 2.6.9-2.6.9L19 21l-.9-2.6-2.6-.9 2.6-.9L19 14z" />
									</svg>
									<p class="text-sm leading-[1.3]">{card.panelDetail ?? 'Write the newsletter for our spring gala'}</p>
								</div>
								<div class="flex flex-col gap-3 rounded-xl bg-brand-soft/60 p-4">
									{draftLines.map((width, index) => (
										<span class="fx-grow h-2 rounded-full bg-brand/20" style={`width:${width};--i:${index}`} />
									))}
								</div>
								</div>
							</div>
						)}

						{card.illustration === 'languages' && (
							<>
								<div class={panel}>
									<img src={img('donation-ellipse-10.svg')} alt="" class="absolute top-1/2 left-[calc(50%-0.33px)] size-[190px] max-w-none -translate-1/2" />
									<div class="absolute top-0 left-0 h-[304px] w-full bg-linear-to-b from-white/80 to-white/0" />
									<div class="absolute bottom-0 left-0 h-[304px] w-full bg-linear-to-t from-white/80 to-white/0" />
									<svg viewBox="0 0 296 296" class="fx-spin-right absolute top-1/2 left-[calc(50%-0.33px)] size-[296px] max-w-none -translate-1/2" aria-hidden="true">
										<defs>
											<linearGradient id="lang-ring-middle" x1="0" y1="0" x2="1" y2="1">
												<stop offset="0" stop-color="#023d9d" stop-opacity="0.55" />
												<stop offset="0.5" stop-color="#023d9d" stop-opacity="0.06" />
												<stop offset="1" stop-color="#023d9d" stop-opacity="0.06" />
											</linearGradient>
										</defs>
										<circle cx="148" cy="148" r="147.5" fill="none" stroke="url(#lang-ring-middle)" />
									</svg>
									<p class="type-h4 absolute top-6 right-6 left-6">{card.panelTitle ?? 'Languages'}</p>
									<svg viewBox="0 0 24 24" class="absolute top-1/2 left-[calc(50%-0.33px)] size-[96px] -translate-1/2 text-brand" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
										<circle cx="12" cy="12" r="9.5" />
										<path d="M2.5 12h19M12 2.5c2.6 2.6 3.9 5.8 3.9 9.5s-1.3 6.9-3.9 9.5c-2.6-2.6-3.9-5.8-3.9-9.5s1.3-6.9 3.9-9.5z" />
									</svg>
									{greetings.map((g, index) => (
										<span
											class="fx-pop absolute rounded-full border border-black/10 bg-white px-3 py-1 text-sm leading-[1.3] shadow-[0_4px_16px_rgb(2_61_157/0.1)]"
											style={`left:${g.left}px;top:${g.top}px;--i:${index}`}
										>
											{g.text}
										</span>
									))}
								</div>
								<div class="absolute top-[311px] left-[calc(50%+0.33px)] flex w-[168px] -translate-x-1/2 flex-col items-center gap-0.5 text-center">
									<p class="text-base leading-[1.2] tracking-[-0.02em]">{card.panelAmount ?? '24 languages'}</p>
									<p class="type-small text-slate">{card.panelDetail ?? 'Automatic translation'}</p>
								</div>
							</>
						)}

						{card.illustration === 'members' && (
							<div class:list={[panel, 'flex flex-col gap-4 p-6']}>
								<p class="type-h4">{card.panelTitle ?? 'Your Members'}</p>
								<ul class="flex flex-col gap-[33px]">
									{members.map((m, index) => (
										<li class="fx-up flex items-center gap-3" style={`--i:${index}`}>
											<Avatar size={40} bg={m.bg} under={m.under} over={m.over} />
											<div class="flex flex-1 flex-col gap-1">
												<p class="text-base leading-[1.2] tracking-[-0.02em]">{m.name}</p>
												<p class="type-small text-slate">{card.panelDetail ?? 'Member since 2026'}</p>
											</div>
											<span class="rounded bg-brand-soft px-2 py-1 text-xs leading-[1.3] font-demi text-brand">
												{card.panelLabel ?? 'Active'}
											</span>
										</li>
									))}
								</ul>
							</div>
						)}

						{card.illustration === 'payments' && (
							<div class={panel}>
								<p class="type-h4 absolute top-6 right-6 left-6">{card.panelTitle ?? 'Membership Payments'}</p>
								<div class="absolute top-1/2 left-1/2 flex h-[68px] -translate-1/2 items-center rounded-[9.714px] border-[1.214px] border-white/70 bg-white/40 p-[19.429px] shadow-[0_8px_32px_rgb(2_61_157/0.12),inset_0_1px_0_rgb(255_255_255/0.9)] ring-1 ring-black/5 backdrop-blur-xl backdrop-saturate-150">
									<div class="flex w-[172.429px] items-center justify-between">
										<span class="flex w-[75.286px] items-center justify-center rounded-[4.857px] bg-[#def5dc] px-[9.714px] py-[4.857px] text-[14.571px] leading-[1.3] font-demi text-[#0a8502]">
											{card.panelLabel ?? 'Paid'}
										</span>
										<p class="text-[19.429px] leading-[1.2] tracking-[-0.02em]">{card.panelAmount ?? '€ 20,00'}</p>
									</div>
								</div>
								{payers.map((p, index) => (
									<Avatar
										size={p.size}
										bg={p.bg}
										under={p.under}
										over={p.over}
										class="fx-pop absolute"
										style={`left:${p.left}px;top:${p.top}px;--i:${index}${p.z === undefined ? '' : `;z-index:${p.z}`}`}
									/>
								))}
							</div>
						)}

						{card.illustration === 'donations' && (
							<>
								<div class={panel}>
									<img src={img('donation-ellipse-10.svg')} alt="" class="absolute top-1/2 left-[calc(50%-0.33px)] size-[190px] max-w-none -translate-1/2" />
									<div class="absolute top-0 left-0 h-[304px] w-full bg-linear-to-b from-white/80 to-white/0" />
									<div class="absolute bottom-0 left-0 h-[304px] w-full bg-linear-to-t from-white/80 to-white/0" />
									{/* Above the white fades so the moving arcs stay visible */}
									<svg viewBox="0 0 296 296" class="fx-spin-right absolute top-1/2 left-[calc(50%-0.33px)] size-[296px] max-w-none -translate-1/2" aria-hidden="true">
											<defs>
												<linearGradient id="ring-middle" x1="0" y1="0" x2="1" y2="1">
													<stop offset="0" stop-color="#023d9d" stop-opacity="0.55" />
													<stop offset="0.5" stop-color="#023d9d" stop-opacity="0.06" />
													<stop offset="1" stop-color="#023d9d" stop-opacity="0.06" />
												</linearGradient>
											</defs>
											<circle cx="148" cy="148" r="147.5" fill="none" stroke="url(#ring-middle)" />
										</svg>
									<svg viewBox="0 0 416 416" class="fx-spin-left absolute top-1/2 left-[calc(50%-0.33px)] size-[416px] max-w-none -translate-1/2" aria-hidden="true">
											<defs>
												<linearGradient id="ring-outer" x1="0" y1="0" x2="1" y2="1">
													<stop offset="0" stop-color="#023d9d" stop-opacity="0.55" />
													<stop offset="0.5" stop-color="#023d9d" stop-opacity="0.06" />
													<stop offset="1" stop-color="#023d9d" stop-opacity="0.06" />
												</linearGradient>
											</defs>
											<circle cx="208" cy="208" r="207.5" fill="none" stroke="url(#ring-outer)" />
										</svg>
									<p class="type-h4 absolute top-6 right-6 left-6">{card.panelTitle ?? 'Donations'}</p>
									<img src={img('donation-heart.svg')} alt="" class="absolute top-1/2 left-[calc(50%-0.33px)] size-[120px] -translate-1/2" />
								</div>
								<div class="absolute top-[311px] left-[calc(50%+0.33px)] flex w-[168px] -translate-x-1/2 flex-col items-center gap-0.5 text-center">
									<p class="text-base leading-[1.2] tracking-[-0.02em]">{card.panelAmount ?? '€ 56,000.00'}</p>
									<p class="type-small text-slate">{card.panelDetail ?? '268 donors'}</p>
								</div>
							</>
						)}
					</div>

					<div class="flex flex-col gap-2">
						<h3 class="type-h4">{card.title}</h3>
						{card.text && <p class="type-body max-w-[395px]">{card.text}</p>}
					</div>
				</div>
				);
			})
		}
	</div>
</section>

<style is:global>
	/* Feature card animations, played when each card scrolls into view (see script below).
	   `data-animate` is only set when motion is allowed, so without it everything is visible. */

	/* Members: rows rise in one after another */
	[data-animate] .fx-up {
		opacity: 0;
	}
	[data-animate][data-inview] .fx-up {
		animation: fx-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(150ms + var(--i, 0) * 130ms);
	}
	@keyframes fx-up {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* Payments: avatars grow from nothing to their size, with a little overshoot */
	[data-animate] .fx-pop {
		transform: scale(0);
	}
	[data-animate][data-inview] .fx-pop {
		animation: fx-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
		animation-delay: calc(200ms + var(--i, 0) * 110ms);
	}
	@keyframes fx-pop {
		from {
			transform: scale(0);
		}
		to {
			transform: scale(1);
		}
	}

	/* Support: the typing dots bounce on a loop */
	[data-inview] .fx-typing {
		animation: fx-typing 1.2s ease-in-out infinite;
		animation-delay: calc(1.2s + var(--i, 0) * 150ms);
	}
	@keyframes fx-typing {
		0%,
		60%,
		100% {
			transform: none;
			opacity: 0.4;
		}
		30% {
			transform: translateY(-3px);
			opacity: 1;
		}
	}

	/* AI assistant: the draft lines write themselves from left to right */
	[data-animate] .fx-grow {
		transform: scaleX(0);
		transform-origin: left;
	}
	[data-animate][data-inview] .fx-grow {
		animation: fx-grow 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(300ms + var(--i, 0) * 180ms);
	}
	@keyframes fx-grow {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* Donations and languages: the rings rotate slowly in opposite directions, on a loop.
	   `rotate` composes with Tailwind's `translate`, so the rings stay centred. */
	[data-inview] .fx-spin-left {
		animation: fx-spin 24s linear infinite reverse;
	}
	[data-inview] .fx-spin-right {
		animation: fx-spin 18s linear infinite;
	}
	@keyframes fx-spin {
		to {
			rotate: 360deg;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const cards = document.querySelectorAll<HTMLElement>('[data-feature-card]');

	if (!reduceMotion && 'IntersectionObserver' in window) {
		cards.forEach((card) => (card.dataset.animate = ''));
		const observer = new IntersectionObserver(
			(entries) =>
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					(entry.target as HTMLElement).dataset.inview = '';
					observer.unobserve(entry.target);
				}),
			{ threshold: 0.35 },
		);
		cards.forEach((card) => observer.observe(card));
	}
</script>
