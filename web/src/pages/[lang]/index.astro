---
import { sanityClient } from 'sanity:client';
import PageView from '../../components/PageView.astro';
import { getLanguages, getLayout, getSiteContext } from '../../lib/data';
import { alternatesFor } from '../../lib/links';
import { PAGE_BY_ID_QUERY } from '../../lib/queries';
import type { Page } from '../../lib/types';

// Rendered when visited (and cached), so anything published in Sanity shows up without a rebuild
const lang = Astro.params.lang!;
const languages = await getLanguages();
const homePageId = languages.includes(lang) ? (await getLayout(lang)).settings?.homePageId : undefined;
const page = homePageId ? await sanityClient.fetch<Page | null>(PAGE_BY_ID_QUERY, { id: homePageId, lang }) : null;
if (!page) return Astro.rewrite('/404');
const ctx = await getSiteContext(lang, alternatesFor(page.translations, languages, 'home'));
---

<PageView page={page} ctx={ctx} kind="home" />
