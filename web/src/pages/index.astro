---
import { BASE_LANGUAGE } from '../lib/languages';

// French is the default language. The root URL always sends visitors and search engines to /fr/
// with a permanent redirect (also declared in vercel.json, which answers before this page runs).
// No guessing from the browser language: Googlebot crawls with an English browser, so a
// language-based redirect made Google treat /en/ as the home page. Visitors switch language
// with the language switcher.
return Astro.redirect(`/${BASE_LANGUAGE}/`, 301);
---
